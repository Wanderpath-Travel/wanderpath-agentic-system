# ==============================================================================
# Wanderpath Autonomous Agent Platform - Environment Configuration
# ==============================================================================

# Application Environment
WANDERPATH_ENV=production
LOG_LEVEL=INFO

# Network Ports
PORT_PLATFORM=8500
PORT_MCP=8000

# Service URLs
PLATFORM_HOST=0.0.0.0
MCP_HOST=0.0.0.0
MCP_SERVER_URL=http://localhost:8000

# SQLite Checkpoint Database Path
DB_PATH=db/wanderpath.sqlite3

# ChromaDB Vector Store Directory
CHROMA_PERSIST_DIR=rag/chroma_db

# ------------------------------------------------------------------------------
# Optional Live LLM Provider API Keys
# (If omitted or empty, the platform operates in deterministic domain mode)
# ------------------------------------------------------------------------------
# Mistral AI (Recommended)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-large-latest

# Google Gemini API
# GEMINI_API_KEY=AIzaSy...

# OpenAI API
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
